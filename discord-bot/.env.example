# Ticket detection: category IDs and/or channel-name prefixes
TICKET_CATEGORY_IDS=
TICKET_PREFIXES=ticket-
# Optional channel where the bot logs what it answered
LOG_CHANNEL_ID=
MAX_AUTO_REPLIES=3
